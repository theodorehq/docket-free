# ============================================================
# Docket environment variables
#
# Copy to .env for local work, and set the same names in your host's
# dashboard for production. NEVER commit .env; it is gitignored.
#
# Only the first two are required. Everything else switches on a feature.
# ============================================================


# ---------- Required: writing submissions to your repo ----------

# A GitHub fine-grained personal access token, scoped to THIS repository
# only, with Contents: Read and write. Nothing else.
# Settings > Developer settings > Personal access tokens > Fine-grained
GITHUB_TOKEN=

# owner/repo, e.g. acme/support
GITHUB_REPO=

# The branch your site deploys from. Usually main.
GITHUB_BRANCH=main


# ---------- Customer email privacy (strongly recommended) ----------

# Submitter addresses are encrypted before they are written to your repo,
# because git history is permanent and deleting a file does not remove what
# was committed. This key is what decrypts them so you can reply.
#
# Generate one:   openssl rand -base64 32
#
# Without it, submissions still work but no address is stored at all, so
# there is no way to reach whoever wrote in. Docket never falls back to
# storing a readable address. Keep this key safe: lose it and every stored
# address becomes permanently unreadable. See LEGAL-CHECKLIST.md.
EMAIL_ENCRYPTION_KEY=


